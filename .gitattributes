# Auto detect text files and perform LF normalization
* text=auto

# Files executed inside Linux containers must keep LF endings on Windows checkouts.
*.sh          text eol=lf
*.py          text eol=lf
*.sql         text eol=lf
*.conf        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.properties  text eol=lf
Dockerfile    text eol=lf
Makefile      text eol=lf
