# Copy to .env to override docker-compose defaults.

# Warehouse credentials
POSTGRES_DB=fraud_dw
POSTGRES_USER=fraud
POSTGRES_PASSWORD=fraud

# Event generator
PRODUCER_RATE=1000          # new transactions per second (total across workers)
PRODUCER_WORKERS=1          # one process sustains ~10k ev/s; add workers for more
SIM_USERS=100000            # cardholder population (seeded into dim_users)
SIM_MERCHANTS=2500
SIM_SEED=42
SIM_FRAUD_SCENARIO_RATE=0.0006

# Streaming
STREAM_TRIGGER_INTERVAL=2 seconds
STREAM_WATERMARK_DELAY=10 minutes
